# Environment variables for bestappever2026

# --- Application Settings ---
# The environment the application is running in (e.g., development, production, test)
NODE_ENV=development
# The port the application server will listen on
PORT=3000
# The base URL for the frontend application (used for things like email links)
FRONTEND_URL=http://localhost:5173

# --- Database Configuration (PostgreSQL example) ---
# Full database connection string. Replace with your actual database URL.
# Example for PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/bestappever2026_dev"

# --- Security & Authentication ---
# A strong, random secret key for the application (e.g., for cookie signing, general secrets).
# Generate a long, random string: openssl rand -base64 32
APP_SECRET=your_app_secret_here_change_this_in_production
# A strong, random secret key for JSON Web Token (JWT) signing.
# Generate a long, random string: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_this_in_production
# Expiration time for JWTs (e.g., '1h', '7d', '24h')
JWT_EXPIRES_IN=1d
# Allowed origins for Cross-Origin Resource Sharing (CORS).
# Use comma-separated values for multiple origins (e.g., "http://localhost:5173,https://yourdomain.com")
# Use "*" for allowing all origins (NOT RECOMMENDED FOR PRODUCTION)
CORS_ORIGIN=http://localhost:5173

# --- Email Service Configuration (SMTP example) ---
# Hostname of the SMTP server
SMTP_HOST=smtp.mailtrap.io
# Port of the SMTP server (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT=2525
# Username for SMTP authentication
SMTP_USER=your_smtp_username
# Password for SMTP authentication
SMTP_PASSWORD=your_smtp_password
# The email address from which automated emails will be sent
SENDER_EMAIL=noreply@bestappever2026.com

# --- Cloud Storage Configuration (AWS S3 example) ---
# AWS Access Key ID
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS S3 Bucket Name
S3_BUCKET_NAME=bestappever2026-uploads
# AWS Region for the S3 bucket
AWS_REGION=us-east-1
# Optional: S3 Endpoint URL if using a custom S3-compatible service
# S3_ENDPOINT=https://s3.customprovider.com

# --- Third-Party API Keys (Example) ---
# Example for a hypothetical payment gateway or external service API key
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# --- Logging Configuration ---
# Minimum logging level (e.g., debug, info, warn, error)
LOG_LEVEL=info

# --- OAuth Providers (Example) ---
# Google OAuth Client ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Callback URL for Google OAuth
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth Client ID
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
# GitHub OAuth Client Secret
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
# Callback URL for GitHub OAuth
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback